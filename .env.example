# Supabase — project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# HMAC secret for signing QR tokens. Generate with: openssl rand -base64 48
QR_SECRET=change-me

# Public origin, used to build invitation links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Without these the rate limiter falls back to an in-process store,
# which is per-instance rather than global.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
